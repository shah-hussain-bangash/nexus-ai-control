{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer-side NEXUS Business v1 compatibility contract",
    "version": "1.0.0",
    "description": "Implement this contract in a reviewed customer sandbox/gateway. This document is not the NEXUS control-plane API. Server authentication must bind the credential, remote tenant and authorized local organizations."
  },
  "servers": [
    {
      "url": "https://sandbox.customer.invalid/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/suppliers/{supplier_id}": {
      "get": {
        "operationId": "lookupSupplier",
        "description": "Return state found and retain the idempotent read operation result. Enforce tenant and organization permissions.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Organization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Contract",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supplier_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result matching the request operation, organization and tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "409": {
            "description": "Operation key reused with a different immutable request. Never create a second effect."
          },
          "503": {
            "description": "Result unavailable. NEXUS retains an unknown outcome and does not replay."
          }
        }
      }
    },
    "/purchase-requests": {
      "post": {
        "operationId": "createPurchaseRequest",
        "description": "Atomically deduplicate by operation/organization/tenant before creating a purchase request. Return state created and every original argument.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Organization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Contract",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operation_id",
                  "organization_id",
                  "tenant_id",
                  "arguments"
                ],
                "properties": {
                  "operation_id": {
                    "type": "string"
                  },
                  "organization_id": {
                    "type": "string"
                  },
                  "tenant_id": {
                    "type": "string"
                  },
                  "arguments": {
                    "$ref": "#/components/schemas/PurchaseArguments"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative result matching the request operation, organization and tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseOperationResult"
                }
              }
            }
          },
          "409": {
            "description": "Operation key reused with a different immutable request. Never create a second effect."
          },
          "503": {
            "description": "Result unavailable. NEXUS retains an unknown outcome and does not replay."
          },
          "201": {
            "description": "Authoritative result matching the request operation, organization and tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseOperationResult"
                }
              }
            }
          }
        }
      }
    },
    "/operations/{operation_id}": {
      "get": {
        "operationId": "reconcileOperation",
        "description": "Authoritative read only. A 404 does not prove an earlier effect did not occur. Never create or retry an effect here.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Tenant",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Organization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Nexus-Contract",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative result matching the request operation, organization and tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "409": {
            "description": "Operation key reused with a different immutable request. Never create a second effect."
          },
          "503": {
            "description": "Result unavailable. NEXUS retains an unknown outcome and does not replay."
          },
          "404": {
            "description": "No authoritative result available; caller retains uncertainty."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BusinessResult": {
        "type": "object",
        "required": [
          "external_ref",
          "state",
          "supplier_id"
        ],
        "properties": {
          "external_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "state": {
            "type": "string",
            "enum": [
              "found",
              "created"
            ]
          },
          "supplier_id": {
            "type": "string",
            "maxLength": 64
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "purpose": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      },
      "OperationResult": {
        "type": "object",
        "required": [
          "operation_id",
          "organization_id",
          "tenant_id",
          "result"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "organization_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/BusinessResult"
          }
        },
        "additionalProperties": false
      },
      "PurchaseArguments": {
        "additionalProperties": false,
        "properties": {
          "supplier_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
            "title": "Supplier Id",
            "type": "string"
          },
          "amount": {
            "pattern": "^[0-9]{1,8}\\.[0-9]{2}$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          },
          "purpose": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "supplier_id",
          "amount",
          "currency",
          "purpose"
        ],
        "title": "PurchaseArguments",
        "type": "object"
      },
      "SupplierArguments": {
        "additionalProperties": false,
        "properties": {
          "supplier_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
            "title": "Supplier Id",
            "type": "string"
          }
        },
        "required": [
          "supplier_id"
        ],
        "title": "SupplierArguments",
        "type": "object"
      },
      "PurchaseResult": {
        "type": "object",
        "required": [
          "external_ref",
          "state",
          "supplier_id",
          "amount",
          "currency",
          "purpose"
        ],
        "properties": {
          "external_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "state": {
            "type": "string",
            "enum": [
              "created"
            ]
          },
          "supplier_id": {
            "type": "string",
            "maxLength": 64
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "purpose": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      },
      "PurchaseOperationResult": {
        "type": "object",
        "required": [
          "operation_id",
          "organization_id",
          "tenant_id",
          "result"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "organization_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/PurchaseResult"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
