# Run backend: python -m nexus.cli init to generate backend/.env secrets and accounts.
# Do not commit real .env files, databases or credentials.
NEXUS_SECRET=
NEXUS_AGENT_SECRET=
NEXUS_MODE=local
NEXUS_POLICY_MODE=reference
NEXUS_DATABASE_URL=sqlite:///./data/nexus.db
NEXUS_MOCK_DATABASE=./data/mock_business.db
NEXUS_ORIGIN=http://localhost:8000
NEXUS_FRONTEND_DIR=../frontend/dist
# Optional organization SSO. Preprovision matching users; trusted IdP must verify email.
NEXUS_OIDC_ISSUER=
NEXUS_OIDC_CLIENT_ID=nexus-console
NEXUS_OIDC_CLIENT_SECRET=
# Optional OPA policy service; outage fails closed.
NEXUS_OPA_URL=http://localhost:8181/v1/data/nexus/decision

# Optional explicit authentication context; map it to a real MFA flow in your IdP.
# Required in pilot mode; a claim is only as trustworthy as the IdP policy behind it.
NEXUS_OIDC_REQUIRED_ACR=
# Optional private enterprise CA PEM bundle. Certificate verification is never disabled.
NEXUS_OIDC_CA_BUNDLE=

# Provider execution is OFF unless explicitly enabled by the operator.
NEXUS_LIVE_INFERENCE=0
# Separate opt-in for local neural search; model must already be installed.
# Pin the exact model:tag and its 64-character lowercase digest from local Ollama.
NEXUS_OLLAMA_EMBEDDING_ENABLED=0
NEXUS_OLLAMA_EMBEDDING_MODEL=
NEXUS_OLLAMA_EMBEDDING_DIGEST=
NEXUS_PROVIDER_HOSTS=
NEXUS_PROVIDER_PRICES={}
NEXUS_MONTHLY_BUDGET_USD=0
NEXUS_INFERENCE_MAX_OUTPUT=4096
NEXUS_INFERENCE_RESPONSE_BYTES=1048576
# Inject actual NEXUS_PROVIDER_* secrets outside source through your secret manager.

# Shared-database, per-organization inference admission limits.
NEXUS_INFERENCE_REQUESTS_PER_MINUTE=30
NEXUS_INFERENCE_MAX_INFLIGHT=4

# Business tools stay synthetic unless an operator explicitly configures HTTP.
# Customer service must implement docs/BUSINESS_CONNECTOR_0_12_0.md.
NEXUS_BUSINESS_CONNECTOR=synthetic
NEXUS_BUSINESS_BASE_URL=
NEXUS_BUSINESS_HOST=
NEXUS_BUSINESS_TENANT=
NEXUS_BUSINESS_TOKEN_ENV=NEXUS_BUSINESS_API_KEY
NEXUS_BUSINESS_TIMEOUT_SECONDS=10
NEXUS_BUSINESS_RESPONSE_BYTES=262144
NEXUS_BUSINESS_CA_BUNDLE=
# Inject NEXUS_BUSINESS_API_KEY through your secret manager; never commit it.
# Optional global monitoring token (32+ characters), kept out of URLs and UI.
NEXUS_METRICS_TOKEN=
# Optional backup key: base64-encoded 32 random bytes; protect separately from backups.
NEXUS_BACKUP_ENCRYPTION_KEY=

# Bounded document intake. OCR is off until Tesseract and language data are provisioned.
NEXUS_INGESTION_OCR_ENABLED=0
NEXUS_TESSERACT_COMMAND=tesseract
NEXUS_INGESTION_OCR_LANGUAGES=eng
NEXUS_INGESTION_TIMEOUT_SECONDS=30
# Default local worker also processes intake; production may separate the workers.
NEXUS_INGESTION_IN_ACTION_WORKER=1

# Optional second-pass local model ordering; disabled until explicitly configured.
NEXUS_OLLAMA_RERANK_ENABLED=0
NEXUS_OLLAMA_RERANK_MODEL=
NEXUS_OLLAMA_RERANK_DIGEST=
