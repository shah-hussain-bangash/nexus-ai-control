# Private operator-provisioned runtime file. Do not commit actual values.
NEXUS_MODE=pilot
NEXUS_SECRET=
NEXUS_AGENT_SECRET=
NEXUS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@MANAGED_DATABASE:5432/nexus?sslmode=verify-full
NEXUS_MOCK_DATABASE=/app/backend/data/mock_business.db
NEXUS_POLICY_MODE=opa
NEXUS_OPA_URL=http://opa:8181/v1/data/nexus/decision
NEXUS_ORIGIN=https://YOUR_HOSTNAME
NEXUS_OIDC_ISSUER=https://YOUR_ISSUER
NEXUS_OIDC_CLIENT_ID=nexus-console
NEXUS_OIDC_CLIENT_SECRET=
NEXUS_OIDC_REQUIRED_ACR=YOUR_VERIFIED_MFA_CONTEXT
# Add a CA bundle mount to compose if required; verification may not be disabled.
NEXUS_LIVE_INFERENCE=0
NEXUS_PROVIDER_HOSTS=
NEXUS_PROVIDER_PRICES={}
NEXUS_MONTHLY_BUDGET_USD=0
NEXUS_INFERENCE_MAX_OUTPUT=4096
# Provider keys must be injected by your secret manager, under the NEXUS_PROVIDER_ prefix.

# Shared-database, per-organization inference admission limits.
NEXUS_INFERENCE_REQUESTS_PER_MINUTE=30
NEXUS_INFERENCE_MAX_INFLIGHT=4
